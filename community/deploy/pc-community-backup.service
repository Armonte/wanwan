[Unit]
Description=PovertyCaster community service: daily SQLite snapshot

[Service]
Type=oneshot
User=fm2k
WorkingDirectory=/home/fm2k/wanwan/community
EnvironmentFile=/home/fm2k/wanwan/community/data/community.env
ExecStart=/home/fm2k/pc-community-venv/bin/python admin.py backup --keep 30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/fm2k/wanwan/community/data
ProtectHome=read-only
